# DocuTrust backend configuration (copy to backend/.env)
# Every value has a built-in default; nothing here is required for the demo.

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API: the CRA dev server and the
# static build server the smoke test uses.
DOCTRUST_CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# --- Synthetic documents ----------------------------------------------------
# 1/true forces regeneration of data/synthetic/* on startup (otherwise the
# content-addressed builder only rewrites files whose generator output
# changed).
#DOCTRUST_FORCE_SYNTH=1

# --- Forensics ---------------------------------------------------------------
# metadata (default) | off. ELA is deliberately not implemented: it measures
# JPEG compression noise, flags honest scans more often than forgeries, and
# the demo does not depend on it.
#DOCTRUST_FORENSIC_MODE=metadata

# --- Optional vision-LLM extraction ------------------------------------------
# The pipeline is deterministic by default (text-layer regexes). Configure
# BOTH values to enable an OpenAI-compatible extraction helper for pages
# with no text layer; it runs with a hard timeout and falls back silently.
#DOCTRUST_LLM_BASE_URL=http://localhost:11434/v1
#DOCTRUST_LLM_API_KEY=
#DOCTRUST_LLM_MODEL=gpt-4o-mini
#DOCTRUST_LLM_TIMEOUT=10

# --- Storage ------------------------------------------------------------------
# SQLite file for the analysis cache + officer reviews.
#DOCTRUST_DB=data/docutrust.sqlite
